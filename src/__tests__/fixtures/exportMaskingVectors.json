{
  "_comment": "エクスポート時のデータマスキング (#733) の共有ゴールデン。Rust (src-tauri/src/db/masking.rs の tests) は cases のルールを正規化してから入力値へ適用し expected と、normalize の rule を正規化して normalized と突き合わせる。フロント (src/__tests__/exportMaskingGolden.test.ts) は normalize を sanitizeMaskRule に通して同じ正規形になることと、cases のルールが既に正規形であることを確認する。hash の期待値は HMAC-SHA256(salt, 値の文字列表現) の小文字 16 進先頭 length 文字 (Python の hmac で独立に算出)。",
  "salt": "noobdb-golden-salt",
  "cases": [
    {
      "name": "fixed_string",
      "rule": {
        "kind": "fixed",
        "value": "***"
      },
      "input": {
        "kind": "string",
        "value": "alice"
      },
      "expected": "***"
    },
    {
      "name": "fixed_custom_on_int_becomes_string",
      "rule": {
        "kind": "fixed",
        "value": "REDACTED"
      },
      "input": {
        "kind": "int",
        "value": 42
      },
      "expected": "REDACTED"
    },
    {
      "name": "fixed_empty_value",
      "rule": {
        "kind": "fixed",
        "value": ""
      },
      "input": {
        "kind": "string",
        "value": "alice"
      },
      "expected": ""
    },
    {
      "name": "fixed_keeps_null",
      "rule": {
        "kind": "fixed",
        "value": "***"
      },
      "input": {
        "kind": "null"
      },
      "expected": null
    },
    {
      "name": "fixed_on_bytes",
      "rule": {
        "kind": "fixed",
        "value": "***"
      },
      "input": {
        "kind": "bytes",
        "value": "deadbeef"
      },
      "expected": "***"
    },
    {
      "name": "partial_email",
      "rule": {
        "kind": "partial",
        "keepStart": 2,
        "keepEnd": 4
      },
      "input": {
        "kind": "string",
        "value": "taro@example.com"
      },
      "expected": "ta**********.com"
    },
    {
      "name": "partial_multibyte_cjk",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 1
      },
      "input": {
        "kind": "string",
        "value": "山田太郎"
      },
      "expected": "山**郎"
    },
    {
      "name": "partial_emoji_zwj_counts_code_points",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 0
      },
      "input": {
        "kind": "string",
        "value": "👨‍👩‍👧"
      },
      "expected": "👨****"
    },
    {
      "name": "partial_surrogate_pair_kept_whole",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 1
      },
      "input": {
        "kind": "string",
        "value": "a😀b😀"
      },
      "expected": "a**😀"
    },
    {
      "name": "partial_short_value_fully_masked",
      "rule": {
        "kind": "partial",
        "keepStart": 2,
        "keepEnd": 2
      },
      "input": {
        "kind": "string",
        "value": "abc"
      },
      "expected": "***"
    },
    {
      "name": "partial_exact_length_fully_masked",
      "rule": {
        "kind": "partial",
        "keepStart": 2,
        "keepEnd": 2
      },
      "input": {
        "kind": "string",
        "value": "abcd"
      },
      "expected": "****"
    },
    {
      "name": "partial_empty_string",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 1
      },
      "input": {
        "kind": "string",
        "value": ""
      },
      "expected": ""
    },
    {
      "name": "partial_phone_keep_last_4",
      "rule": {
        "kind": "partial",
        "keepStart": 0,
        "keepEnd": 4
      },
      "input": {
        "kind": "string",
        "value": "090-1234-5678"
      },
      "expected": "*********5678"
    },
    {
      "name": "partial_on_int",
      "rule": {
        "kind": "partial",
        "keepStart": 0,
        "keepEnd": 2
      },
      "input": {
        "kind": "int",
        "value": 1234567
      },
      "expected": "*****67"
    },
    {
      "name": "partial_on_negative_int",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 0
      },
      "input": {
        "kind": "int",
        "value": -42
      },
      "expected": "-**"
    },
    {
      "name": "partial_on_bool",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 0
      },
      "input": {
        "kind": "bool",
        "value": true
      },
      "expected": "t***"
    },
    {
      "name": "partial_on_bytes_hex_text",
