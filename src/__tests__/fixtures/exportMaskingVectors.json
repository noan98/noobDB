        "kind": "partial",
        "keepStart": 2,
        "keepEnd": 2
      },
      "input": {
        "kind": "bytes",
        "value": "deadbeef"
      },
      "expected": "de****ef"
    },
    {
      "name": "partial_keeps_null",
      "rule": {
        "kind": "partial",
        "keepStart": 1,
        "keepEnd": 1
      },
      "input": {
        "kind": "null"
      },
      "expected": null
    },
    {
      "name": "partial_keep_clamped_to_max",
