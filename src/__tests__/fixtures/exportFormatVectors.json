            "value": "-1e5"
          },
          {
            "kind": "int",
            "value": 0
          }
        ],
        [
          {
            "kind": "string",
            "value": "@SUM(A1)"
          },
          {
            "kind": "int",
            "value": 0
          }
        ],
        [
          {
            "kind": "string",
            "value": "-cmd|'/c calc"
          },
          {
            "kind": "int",
            "value": 0
          }
        ]
      ],
      "query": null,
      "sql": {
        "driver": "mysql",
        "table": "t",
        "batchSize": 100
      },
      "expected": {
        "csv": "v,n\r\n'=1+2,-5\r\n-5,0\r\n+3.2,0\r\n-1e5,0\r\n'@SUM(A1),0\r\n'-cmd|'/c calc,0\r\n",
        "json": "[\n  {\n    \"n\": -5,\n    \"v\": \"=1+2\"\n  },\n  {\n    \"n\": 0,\n    \"v\": \"-5\"\n  },\n  {\n    \"n\": 0,\n    \"v\": \"+3.2\"\n  },\n  {\n    \"n\": 0,\n    \"v\": \"-1e5\"\n  },\n  {\n    \"n\": 0,\n    \"v\": \"@SUM(A1)\"\n  },\n  {\n    \"n\": 0,\n    \"v\": \"-cmd|'/c calc\"\n  }\n]",
        "markdown": "| v | n |\n| --- | --- |\n| =1+2 | -5 |\n| -5 | 0 |\n| +3.2 | 0 |\n| -1e5 | 0 |\n| @SUM(A1) | 0 |\n| -cmd\\|'/c calc | 0 |\n",
        "ndjson": "{\"n\":-5,\"v\":\"=1+2\"}\n{\"n\":0,\"v\":\"-5\"}\n{\"n\":0,\"v\":\"+3.2\"}\n{\"n\":0,\"v\":\"-1e5\"}\n{\"n\":0,\"v\":\"@SUM(A1)\"}\n{\"n\":0,\"v\":\"-cmd|'/c calc\"}\n",
        "sql": "INSERT INTO `t` (`v`, `n`) VALUES\n  ('=1+2', -5),\n  ('-5', 0),\n  ('+3.2', 0),\n  ('-1e5', 0),\n  ('@SUM(A1)', 0),\n  ('-cmd|''/c calc', 0);\n"
      }
    },
    {
      "name": "sorted-keys-and-unicode",
      "note": "JSON/NDJSON のキー順は serde_json の BTreeMap 出力 (= UTF-8 バイト順 = コードポイント順) に一致させる。非 BMP の絵文字 (U+1F642) は UTF-16 単位で比較すると先頭サロゲート 0xD83D が全角 Ａ (U+FF21) より小さくなるため、JS の素の文字列比較ではキー順がバックエンドとズレる — その境界をここで固定する。私用領域文字 (U+E000) も z と Ａ の間に入る位置関係の確認用",
      "columns": [
        {
          "name": "z",
          "typeName": "text"
        },
        {
          "name": "a",
          "typeName": "text"
        },
        {
          "name": "Ａ",
          "typeName": "text"
        },
        {
          "name": "🙂",
          "typeName": "text"
        },
        {
          "name": "",
          "typeName": "text"
        }
      ],
      "rows": [
        [
          {
            "kind": "string",
            "value": "zv"
          },
          {
            "kind": "string",
            "value": "av"
          },
          {
            "kind": "string",
            "value": "full-width"
          },
          {
            "kind": "string",
            "value": "emoji"
          },
          {
            "kind": "string",
            "value": "private-use"
          }
        ]
      ],
      "query": null,
      "sql": {
        "driver": "duckdb",
        "table": "t",
        "batchSize": 100
      },
      "expected": {
        "csv": "z,a,Ａ,🙂,\r\nzv,av,full-width,emoji,private-use\r\n",
        "json": "[\n  {\n    \"a\": \"av\",\n    \"z\": \"zv\",\n    \"\": \"private-use\",\n    \"Ａ\": \"full-width\",\n    \"🙂\": \"emoji\"\n  }\n]",
        "markdown": "| z | a | Ａ | 🙂 |  |\n| --- | --- | --- | --- | --- |\n| zv | av | full-width | emoji | private-use |\n",
        "ndjson": "{\"a\":\"av\",\"z\":\"zv\",\"\":\"private-use\",\"Ａ\":\"full-width\",\"🙂\":\"emoji\"}\n",
        "sql": "INSERT INTO \"t\" (\"z\", \"a\", \"Ａ\", \"🙂\", \"\") VALUES\n  ('zv', 'av', 'full-width', 'emoji', 'private-use');\n"
      }
    },
    {
      "name": "sql-batching-and-quoting",
      "note": "SQL INSERT: batchSize ごとに 1 文へまとめ、識別子/リテラルは方言別にエスケープする",
      "columns": [
        {
          "name": "we\"ird",
          "typeName": "text"
        },
        {
          "name": "n",
          "typeName": "int"
        }
      ],
      "rows": [
        [
          {
            "kind": "string",
            "value": "O'Brien"
          },
          {
            "kind": "int",
            "value": 1
          }
        ],
        [
          {
            "kind": "string",
            "value": "a\\b"
          },
          {
            "kind": "int",
            "value": 2
          }
        ],
        [
          {
            "kind": "null"
          },
          {
            "kind": "int",
            "value": 3
          }
        ]
      ],
      "query": null,
      "sql": {
        "driver": "postgres",
        "table": "sch ema",
        "batchSize": 2
