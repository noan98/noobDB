      "expected": {
        "csv": "\"we\"\"ird\",n\r\nO'Brien,1\r\na\\b,2\r\n,3\r\n",
        "json": "[\n  {\n    \"n\": 1,\n    \"we\\\"ird\": \"O'Brien\"\n  },\n  {\n    \"n\": 2,\n    \"we\\\"ird\": \"a\\\\b\"\n  },\n  {\n    \"n\": 3,\n    \"we\\\"ird\": null\n  }\n]",
        "markdown": "| we\"ird | n |\n| --- | --- |\n| O'Brien | 1 |\n| a\\\\b | 2 |\n|  | 3 |\n",
        "ndjson": "{\"n\":1,\"we\\\"ird\":\"O'Brien\"}\n{\"n\":2,\"we\\\"ird\":\"a\\\\b\"}\n{\"n\":3,\"we\\\"ird\":null}\n",
        "sql": "INSERT INTO \"sch ema\" (\"we\"\"ird\", \"n\") VALUES\n  ('O''Brien', 1),\n  ('a\\b', 2);\nINSERT INTO \"sch ema\" (\"we\"\"ird\", \"n\") VALUES\n  (NULL, 3);\n"
      }
    },
    {
      "name": "blob-known-divergence",
      "note": "BLOB はバックエンドが 0x 前置 (CSV/Markdown) / 16 進文字列 (JSON) / 方言別バイナリリテラル (SQL) にするが、フロントは JSON 化された 16 進文字列としてしか受け取れず String と区別できない。既知かつ意図的な差分として frontendExpected に明記する",
      "columns": [
        {
          "name": "b",
          "typeName": "blob"
        }
      ],
      "rows": [
        [
          {
            "kind": "bytes",
            "value": "ab12"
          }
        ]
      ],
      "query": null,
      "sql": {
        "driver": "mysql",
        "table": "t",
        "batchSize": 100
      },
      "expected": {
        "csv": "b\r\n0xab12\r\n",
        "json": "[\n  {\n    \"b\": \"0xab12\"\n  }\n]",
        "markdown": "| b |\n| --- |\n| 0xab12 |\n",
        "ndjson": "{\"b\":\"0xab12\"}\n",
        "sql": "INSERT INTO `t` (`b`) VALUES\n  (X'ab12');\n"
      },
      "frontendExpected": {
        "csv": "b\r\nab12\r\n",
        "json": "[\n  {\n    \"b\": \"ab12\"\n  }\n]",
        "ndjson": "{\"b\":\"ab12\"}\n",
        "markdown": "| b |\n| --- |\n| ab12 |\n",
        "sql": "INSERT INTO `t` (`b`) VALUES\n  ('ab12');\n"
      }
    }
  ]
