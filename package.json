{
  "name": "noobdb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:update": "VITE_RUN_VISUAL=1 vitest run --config vitest.browser.config.ts --update",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "bench:ui": "vitest run --config vitest.perf.config.ts",
    "lint": "biome check --max-diagnostics=none src",
    "knip": "knip",
    "mutants:js": "stryker run",
    "bundle-size": "node scripts/bundle-size.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "tauri": "tauri"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/react": "^11.14.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xyflow/react": "^12.11.6",
    "codemirror": "^6.0.1",
    "html-to-image": "^1.11.13",
    "motion": "^13.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/tauri-service": "^1.5.0",
    "@wdio/types": "^10.0.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0",
    "vitest-browser-react": "^2.2.0"
  },
  "pnpm": {
    "overrides": {
      "qs@6.15.1": "^6.16.0"
    }
  }
