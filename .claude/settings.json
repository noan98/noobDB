{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce-japanese.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "言語ポリシーを適用中"
          }
        ]
      }
    ]
  }
}
